; Exports of the xdb format plugin: the standard 7-Zip archive exports
; (third_party/7zip/CPP/7zip/Archive/Archive2.def) plus GetFormatOptions,
; which the Tosox/7zip fork reads to build its "Format options" dialog.
; Listing it here keeps the name undecorated on Win32.

EXPORTS
  CreateObject PRIVATE

  GetHandlerProperty PRIVATE
  GetNumberOfFormats PRIVATE
  GetHandlerProperty2 PRIVATE
  GetIsArc PRIVATE

  GetNumberOfMethods PRIVATE
  GetMethodProperty PRIVATE
  CreateDecoder PRIVATE
  CreateEncoder PRIVATE

  GetHashers PRIVATE

  SetCodecs PRIVATE

  SetLargePageMode PRIVATE
  SetCaseSensitive PRIVATE

  GetModuleProp PRIVATE
